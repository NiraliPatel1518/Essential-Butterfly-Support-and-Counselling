{
  "family": "${FAMILY}",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "2048",
  "runtimePlatform": {
    "operatingSystemFamily": "LINUX",
    "cpuArchitecture": "${CPU_ARCH}"
  },
  "executionRoleArn": "${LAB_ROLE_ARN}",
  "taskRoleArn": "${LAB_ROLE_ARN}",
  "containerDefinitions": [
    {
      "name": "backend",
      "image": "${ECR_BACKEND}:${IMAGE_TAG}",
      "essential": true,
      "portMappings": [{ "containerPort": 8080, "protocol": "tcp" }],
      "environment": [
        { "name": "SPRING_DATASOURCE_URL", "value": "${DB_URL}" },
        { "name": "SPRING_DATASOURCE_USERNAME", "value": "${DB_USER}" },
        { "name": "APP_PUBLIC_BASE_URL", "value": "${SITE_URL}" },
        { "name": "APP_FRONTEND_BASE_URL", "value": "${SITE_URL}" },
        { "name": "CORS_ALLOWED_ORIGINS", "value": "${SITE_URL}" },
        { "name": "SPRING_JPA_SHOW_SQL", "value": "false" },
        { "name": "MEMORY_WALL_STORAGE", "value": "s3" },
        { "name": "MEMORY_WALL_S3_BUCKET", "value": "${S3_BUCKET}" },
        { "name": "MEMORY_WALL_S3_REGION", "value": "${S3_REGION}" },
        { "name": "JAVA_TOOL_OPTIONS", "value": "-XX:MaxRAMPercentage=60" }
      ],
      "secrets": [],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "${LOG_GROUP}",
          "awslogs-region": "${AWS_REGION}",
          "awslogs-stream-prefix": "backend"
        }
      }
    },
    {
      "name": "web",
      "image": "${ECR_WEB}:${IMAGE_TAG}",
      "essential": true,
      "portMappings": [{ "containerPort": 80, "protocol": "tcp" }],
      "dependsOn": [{ "containerName": "backend", "condition": "START" }],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "${LOG_GROUP}",
          "awslogs-region": "${AWS_REGION}",
          "awslogs-stream-prefix": "web"
        }
      }
    }
  ]
}
